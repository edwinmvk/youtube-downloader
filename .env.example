# Browser-facing origin. In local Docker, Nginx serves the app from http://localhost.
FRONTEND_URL=http://localhost

# Total request body limit for the Flask upload endpoint.
MAX_FILE_SIZE_MB=500

# In-memory async download worker count. Keep this at 1 backend container/worker
# until job state is moved to a shared store such as Redis.
MAX_CONCURRENT_DOWNLOADS=2

# How long completed async jobs remain available in memory.
DOWNLOAD_JOB_TTL_SECONDS=1800

# Docker Compose service name for the PO Token provider.
POT_PROVIDER_URL=http://bgutil-provider:4416

# Browser-facing API base URL. Nginx routes /api to Flask.
NEXT_PUBLIC_API_URL=/api
